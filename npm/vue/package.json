{
  "name": "@aaa-organization-zzz/aaa-module-template-zzz-vue",
  "version": "0.1.0",
  "description": "Headless Vue composables for aaa-module-template-zzz.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src/generated",
    "src/pages",
    "src/pages.ts"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./pages": {
      "types": "./src/pages.ts",
      "import": "./src/pages.ts"
    },
    "./backend": {
      "types": "./src/generated/backend.ts",
      "import": "./src/generated/backend.ts"
    }
  },
  "inertiaModule": {
    "pageExport": "./pages"
  },
  "scripts": {
    "generate": "inertia-module generate",
    "generate:check": "inertia-module generate --check",
    "build": "tsup src/index.ts --format esm --dts --clean",
    "prepack": "npm run generate",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@inertiajs/vue3": "^3.0.0",
    "@starter-solutions/vue-ui": "^0.1.4",
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@starter-solutions/inertia-module-utils": "file:../module-utils"
  },
  "devDependencies": {
    "@inertiajs/vue3": "^3.0.0",
    "@starter-solutions/vue-ui": "^0.1.4",
    "@types/node": "^22.10.0",
    "@vue/tsconfig": "^0.7.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "vue": "^3.4.0",
    "vue-tsc": "^2.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
